{
	"name": "frappe-ui-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build --base=/assets/alumni_nit_srinagar/frontend/ && yarn copy-html-entry",
		"preview": "vite preview",
		"lint": "biome check --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"copy-html-entry": "cp ../alumni_nit_srinagar/public/frontend/index.html ../alumni_nit_srinagar/www/frontend.html"
	},
	"dependencies": {
		"feather-icons": "^4.29.2",
		"frappe-ui": "^0.1.192",
		"showdown": "^2.1.0",
		"socket.io-client": "^4.7.2",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@iconify-json/lucide": "^1.2.118",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vitest/coverage-v8": "^2.1.8",
		"autoprefixer": "^10.4.2",
		"jsdom": "^25.0.1",
		"postcss": "^8.4.5",
		"tailwindcss": "^3.4.15",
		"unplugin-icons": "^23.0.1",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.0.13",
		"vite-plugin-vue-devtools": "^8.1.1",
		"vitest": "^2.1.8"
	}
}
